# =============================================================================
# TundaGula Unified — Environment Variables
# Copy this file to .env and fill in production values
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL — used by Docker)
# ---------------------------------------------------------------------------
POSTGRES_DB=tundagula
POSTGRES_USER=tundagula
POSTGRES_PASSWORD=tundagula_secret_password

# ---------------------------------------------------------------------------
# Backend (Django)
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3002,http://localhost:5173

DB_ENGINE=postgresql
DB_NAME=tundagula
DB_USER=tundagula
DB_PASSWORD=tundagula_secret_password
DB_HOST=db
DB_PORT=5432

# Django Superuser (created on first boot by entrypoint)
DJANGO_SUPERUSER_PHONE=0700000000
DJANGO_SUPERUSER_NAME=Admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_ROLE=admin

# Mobile Money APIs
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=

# SMS Gateway (Africa's Talking)
AT_API_KEY=atsk_97e9b8f1cd10289e453e75f5e703708f146f7b50e70a4446895030e1175d206dd833173f
AT_USERNAME=tundagula

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# This URL is baked into the React app during the Docker build stage.
VITE_API_URL=http://localhost:8001/api/v1
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,40.127.8.37
VITE_API_URL=http://40.127.8.37:8001/api/v1